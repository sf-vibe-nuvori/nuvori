{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nuvori Inventory State Contract",
  "description": "localStorage(nuvori_poc_state_v2) 저장 구조 — web 앱과 db/ 마이그레이션의 계약.",
  "type": "object",
  "required": ["items", "receipts"],
  "properties": {
    "subMode": { "type": "string", "enum": ["inventory", "buy", "receipt", "chat"] },
    "recipeMode": { "type": "string", "enum": ["list", "chat"] },
    "dayOffset": { "type": "integer" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "price", "cycleDays", "boughtDay"],
        "properties": {
          "id": { "type": "string" },
          "thumbKey": { "type": "string", "description": "ITEM_IMAGES 키 (inferThumbKey로 추론)" },
          "name": { "type": "string" },
          "price": { "type": "number" },
          "lastStore": { "type": "string" },
          "lastPurchaseDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "cycleDays": { "type": "integer", "minimum": 1, "description": "3-State HSMM 소비주기" },
          "boughtDay": { "type": "integer", "description": "dayOffset 기준 상대 구매일" },
          "manualNeedToBuy": { "type": "boolean" },
          "isManuallyAdded": { "type": "boolean" },
          "checkedForOrder": { "type": "boolean" }
        }
      }
    },
    "receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "storeName", "purchaseDate", "items"],
        "properties": {
          "id": { "type": "string" },
          "storeName": { "type": "string" },
          "purchaseDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "addedItemIds": { "type": "array", "items": { "type": "string" } },
          "prevItemMap": { "type": "object", "description": "수정/삭제 시 인벤토리 되돌리기용 이전 상태 스냅샷" },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "name": { "type": "string" },
                "price": { "type": "number" },
                "cycleDays": { "type": "integer" }
              }
            }
          }
        }
      }
    }
  }
}
